#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue
    fi
    if [[ "$remote_oid" =~ ^0+$ ]]; then
        # New branches and tags can start at an already reviewed remote commit.
        remote_oid=$(git merge-base "$local_oid" "refs/remotes/$1/main" || true)
    fi
    args=(--revision "$local_oid^{commit}")
    if [[ -n "$remote_oid" ]]; then
        args+=(--base "$remote_oid^{commit}")
    fi
    python3 tools/audit_repository.py "${args[@]}" </dev/null
done
